#!/bin/sh
[ -n "${IPKG_INSTROOT}" ] && exit 0

# On real removal (not upgrade): drop the cron line. Persisted state under
# /etc/xray-monitor (staged subscriptions, backups) is intentionally KEPT.
# Upgrades pass "upgrade" here, so state/cron survive package updates.
if [ "$1" = "remove" ]; then
	CRON=/etc/crontabs/root
	[ -f "$CRON" ] && sed -i '/xray-monitor\/xray-sub fetch/d' "$CRON" 2>/dev/null
	/etc/init.d/cron restart 2>/dev/null

	# Intentionally do NOT `rm -rf /etc/xray-monitor`: a reinstall done with
	# `opkg install --force-reinstall` runs this prerm with "remove", so deleting
	# state here wipes it on what the user meant as an upgrade. Leave the dir for
	# manual cleanup after a real uninstall.
fi
exit 0
