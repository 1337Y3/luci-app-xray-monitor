#!/bin/sh
# Remnawave multi-subscription / config helper for luci-app-xray-monitor.
# Commands: fetch | apply | status | set-cfg ... | cron-sync
#         | sub-add <prefix> <url> | sub-del <id> | sub-edit <id> <prefix> <url> <enabled>
#         | routing-get | routing-set <f> | balancers-get | balancers-set <f>
#         | config-save <f> | enable-api
SHARE=/usr/share/xray-monitor
STATE=/etc/xray-monitor
XRAY=/usr/bin/xray
FEED="https://raw.githubusercontent.com/1337Y3/luci-app-xray-monitor/main/docs"
REL="https://github.com/1337Y3/luci-app-xray-monitor/releases/latest/download/luci-app-xray-monitor.ipk"
PKG=luci-app-xray-monitor

config_file() {
	local f; f=$(uci -q get xray.config.conffiles 2>/dev/null | awk '{print $1}')
	[ -f "$f" ] && { echo "$f"; return; }
	echo "/etc/xray/config.json"
}
CFG=$(config_file)
mkdir -p "$STATE"

# Mutating commands (fetch/apply/sub-*/set-cfg/routing-set/balancers-set/
# config-save/enable-api/cron-sync) serialize on this lock so concurrent cron
# fetches and UI/RPC clicks can't interleave uci commits, staging and config
# renames. Read-only commands skip it. OpenWrt's lock(1) has no bounded wait
# (`-w` waits but does not acquire), so poll the non-blocking `-n` try with a
# cap; the EXIT trap releases the lock on every path.
LOCK=/var/lock/xray-monitor
held=0
STAGE_DIR=""
cleanup() {
	[ -n "$STAGE_DIR" ] && rm -rf "$STAGE_DIR"
	[ "$held" = 1 ] && lock -u "$LOCK" </dev/null >/dev/null 2>&1
	return 0
}
trap cleanup EXIT

ua_default=$(uci -q get xray-monitor.sub.user_agent); [ -n "$ua_default" ] || ua_default="v2rayNG/1.8.0"
cron=$(uci -q get xray-monitor.sub.cron); [ -n "$cron" ] || cron=1
cron_schedule=$(uci -q get xray-monitor.sub.cron_schedule); [ -n "$cron_schedule" ] || cron_schedule="0 * * * *"
auto_apply=$(uci -q get xray-monitor.sub.auto_apply); [ -n "$auto_apply" ] || auto_apply=0

fetch_url() {  # <url> <user-agent> [header-dump-file]
	local hdr="${3:-/dev/null}"
	if command -v curl >/dev/null 2>&1; then curl -s -D "$hdr" -A "$2" --max-time 25 "$1"
	else uclient-fetch -q -O - -U "$2" -T 25 "$1"; fi
}

# Parse the standard `subscription-userinfo` response header into usage state:
#   subscription-userinfo: upload=0; download=123; total=456; expire=1735689600
# (bytes; total=0 = unlimited, expire=0 = never). Writes $STATE/usage-<id>.json,
# or removes it when the header is absent.
store_usage() {  # <key> <header-file>   key = subscription prefix (stable in both shell & ucode)
	local key="$1" hf="$2" line up dn tot exp title
	[ -f "$hf" ] || return 0
	# profile-title (plan name) — plain or "base64:" prefixed. Stored raw (the browser
	# decodes base64 via atob; BusyBox has no base64 applet); a separate file lets
	# status.uc JSON-escape it safely.
	title=$(grep -i '^profile-title:' "$hf" 2>/dev/null | tail -n1 | sed 's/^[^:]*:[[:space:]]*//' | tr -d '\r')
	if [ -n "$title" ]; then printf '%s' "$title" > "$STATE/title-$key.txt"; else rm -f "$STATE/title-$key.txt"; fi
	line=$(grep -i '^subscription-userinfo:' "$hf" 2>/dev/null | tail -n1)
	[ -n "$line" ] || { rm -f "$STATE/usage-$key.json"; return 0; }
	up=$(echo  "$line" | sed -n 's/.*upload=\([0-9][0-9]*\).*/\1/p')
	dn=$(echo  "$line" | sed -n 's/.*download=\([0-9][0-9]*\).*/\1/p')
	tot=$(echo "$line" | sed -n 's/.*total=\([0-9][0-9]*\).*/\1/p')
	exp=$(echo "$line" | sed -n 's/.*expire=\([0-9][0-9]*\).*/\1/p')
	printf '{"upload":%s,"download":%s,"total":%s,"expire":%s,"ts":%s}\n' \
		"${up:-0}" "${dn:-0}" "${tot:-0}" "${exp:-0}" "$(date +%s)" > "$STATE/usage-$key.json"
}

sub_ids() { uci show xray-monitor 2>/dev/null | sed -n 's/^xray-monitor\.\([^.]*\)=subscription$/\1/p'; }
# Prefixes of ALL configured subscriptions, enabled or disabled. Everything
# tagged <prefix> or <prefix>-* in config.json is "managed": fetch/apply may
# replace or prune it. Proxy outbounds the user added by hand must therefore
# never use one of these prefixes - they are preserved in the local block.
sub_prefixes() {
	local id p
	for id in $(sub_ids); do
		p=$(uci -q get "xray-monitor.$id.prefix")
		printf '%s ' "${p:-proxy}"
	done
}
valid_prefix() { echo "$1" | grep -qE '^[A-Za-z0-9_-]+$'; }
# A new prefix must not OVERLAP an existing one: "proxy" vs "proxy-work" (either
# direction, or equality) makes the managed-tag rule "<prefix> or <prefix>-*"
# ambiguous - ownership would depend on argument order and staged groups could
# carry the same outbound tag twice, which xray -test rejects. Prints the
# conflicting existing prefix and returns 0 when <new> overlaps, 1 otherwise.
prefix_conflict() {  # <new-prefix> <exclude-id>
	local id e
	for id in $(sub_ids); do
		[ "$id" = "$2" ] && continue
		e=$(uci -q get "xray-monitor.$id.prefix"); [ -n "$e" ] || e=proxy
		if [ "$1" = "$e" ]; then printf '%s\n' "$e"; return 0; fi
		case "$1" in "$e"-*) printf '%s\n' "$e"; return 0 ;; esac   # new nests under existing
		case "$e" in "$1"-*) printf '%s\n' "$e"; return 0 ;; esac   # existing nests under new
	done
	return 1
}

# Keep the newest $1 (default 3) "$CFG.bak.*" backups, delete the rest.
# Only ever runs after a config change verified working (xray -test + restart).
prune_backups() {
	local keep="${1:-3}" f n=0
	for f in $(ls -t "$CFG".bak.* 2>/dev/null); do
		n=$((n + 1))
		[ "$n" -le "$keep" ] && continue
		[ "$f" = "$CFG" ] && continue   # never the live config
		rm -f "$f"
	done
}

# Dot-paths INSIDE an outbound whose change must not read as a diff, e.g. the
# panel-randomized spiderX. Defaults to streamSettings.realitySettings.spiderX;
# setting the list (uci add_list xray-monitor.sub.diff_ignore='<a.b.c>')
# replaces the default. Apply always writes the staged outbounds in full.
diff_ignore() {
	local list
	list=$(uci -q get xray-monitor.sub.diff_ignore)
	if [ -n "$list" ]; then echo "$list"; else echo "streamSettings.realitySettings.spiderX"; fi
}

# Stats API reachability probe (rc 0 = answering on 127.0.0.1:10085).
APISRV="127.0.0.1:10085"
api_up() { "$XRAY" api statsquery --server="$APISRV" >/dev/null 2>&1; }

# Candidate configs for `xray -test` are staged as $d/config.json inside their
# own mktemp(1) directory, never next to $CFG: when xray runs with `-confdir D`
# it loads every D/*.json, so a leftover `config.json.new.json` there would be
# double-loaded. The extension-less copy keeps the final rename atomic on the
# same filesystem while staying invisible to -confdir. Removed by the EXIT trap.
#   stage_init      -> $STAGE_DIR created, candidate = $STAGE_DIR/config.json
#   test_config     -> xray -test on a candidate (no writes anywhere)
#   install_config  -> cp -> <target>.new -> mv onto the target (atomic)
#   test_and_install <candidate> -> test_config || return; install_config
# Writers run test_config BEFORE making the backup: a backup is only worth
# keeping if a verified candidate actually follows it, and prune_backups keeps
# just 3 - a series of failed attempts must not evict the meaningful ones.
stage_init() {
	STAGE_DIR=$(mktemp -d "${TMPDIR:-/tmp}/xraymon.XXXXXX") || exit 1
}

test_config() {  # <candidate config.json> — validate only; no config writes
	"$XRAY" -test -format json -config "$1" >/dev/null 2>&1
}

install_config() {  # <validated candidate> — atomically replace the live config
	# $CFG may be a symlink (config-save used to write through it with `cat >`);
	# cp+mv on $CFG itself would replace the LINK with a regular file. Resolve
	# the target so the symlink survives and the rename stays atomic on it.
	local target="$CFG" tmp
	[ -L "$target" ] && target=$(readlink -f "$target")
	tmp="$target.new"
	cp "$1" "$tmp" && mv "$tmp" "$target" || { rm -f "$tmp"; return 1; }
}

test_and_install() {  # <candidate config.json> — test, then install
	test_config "$1" || return 1
	install_config "$1"
}

# After a config change + restart, confirm xray came back healthy; if not,
# restore the pre-change backup and restart. $1 = backup file to restore,
# $2 = 1 to also require the stats API to answer (else only require xray up).
verify_or_rollback() {
	local bak="$1" need_api="$2" i
	for i in 1 2 3 4 5; do
		if pgrep -f "$XRAY run" >/dev/null 2>&1 && { [ "$need_api" != 1 ] || api_up; }; then
			return 0
		fi
		sleep 1
	done
	[ -f "$bak" ] && cp -a "$bak" "$CFG"
	/etc/init.d/xray restart >/dev/null 2>&1
	return 1
}

# `apply` as a function: the command runs it under the lock, and fetch's
# auto-apply calls it in-process - re-running `"$0" apply` would deadlock on
# the very lock fetch already holds. Non-zero return (and state files) on any
# failure; rc propagates to the caller.
do_apply() {
	[ -s "$STATE/staged.json" ] || { echo "nothing staged"; return 1; }
	api_before=0; api_up && api_before=1
	stage_init
	apply_err=$("$SHARE/apply.uc" "$CFG" "$STATE/staged.json" "$STAGE_DIR/config.json" $(sub_prefixes) 2>&1 >/dev/null)
	if [ -n "$apply_err" ]; then
		echo "merge-failed" > "$STATE/status"
		echo "staged merge failed - not applied: $apply_err"; return 1
	fi
	test_config "$STAGE_DIR/config.json" || {
		echo "test-failed" > "$STATE/status"; echo "config test failed - not applied"; return 1; }
	bak="$CFG.bak.$(date +%Y%m%d-%H%M%S)"; cp -a "$CFG" "$bak"
	install_config "$STAGE_DIR/config.json" || {
		echo "install-failed" > "$STATE/status"; echo "failed to install new config"; return 1; }
	/etc/init.d/xray restart >/dev/null 2>&1
	if verify_or_rollback "$bak" "$api_before"; then
		prune_backups
		echo 0 > "$STATE/pending"; echo "applied" > "$STATE/status"; echo ok
	else
		echo "rolled-back" > "$STATE/status"; echo "applied but xray/api failed health check - rolled back"; return 1
	fi
}

# cron-sync likewise: set-cfg calls it in-process instead of `"$0" cron-sync`.
do_cron_sync() {
	CRON=/etc/crontabs/root
	mkdir -p /etc/crontabs; touch "$CRON"
	sed -i '/xray-monitor\/xray-sub fetch/d' "$CRON" 2>/dev/null
	[ "$cron" != "0" ] && echo "$cron_schedule /usr/share/xray-monitor/xray-sub fetch >/dev/null 2>&1" >> "$CRON"
	/etc/init.d/cron enable 2>/dev/null; /etc/init.d/cron restart 2>/dev/null
	echo ok
}

case "$1" in
	fetch|apply|routing-set|balancers-set|config-save|enable-api|sub-add|sub-del|sub-edit|set-cfg|cron-sync)
		lw=0
		# The lock(1) holder is a lingering child process: redirect ALL its fds,
		# or it inherits this script's stdout - under rpcd that is the command
		# substitution pipe, which then never sees EOF and the call hangs until
		# the rpcd timeout long after this script has exited.
		while ! lock -n "$LOCK" </dev/null >/dev/null 2>&1; do
			lw=$((lw + 1))
			[ "$lw" -ge 55 ] && { echo "another xray-monitor operation is running"; exit 1; }
			sleep 1
		done
		held=1
		;;
esac

case "$1" in
	fetch)
		tmpd=$(mktemp -d); staged="$tmpd/staged.json"
		printf '{"groups":[' > "$staged"
		first=1; nsub=0; nok=0; failed=""
		for id in $(sub_ids); do
			[ "$(uci -q get "xray-monitor.$id.enabled")" = "0" ] && continue
			url=$(uci -q get "xray-monitor.$id.url"); [ -n "$url" ] || continue
			prefix=$(uci -q get "xray-monitor.$id.prefix"); [ -n "$prefix" ] || prefix="proxy"
			ua=$(uci -q get "xray-monitor.$id.user_agent"); [ -n "$ua" ] || ua="$ua_default"
			nsub=$((nsub + 1))
			raw="$tmpd/$id.raw"; obs="$tmpd/$id.obs"; hdrf="$tmpd/$id.hdr"
			if fetch_url "$url" "$ua" "$hdrf" > "$raw" 2>/dev/null && [ -s "$raw" ]; then
				store_usage "$prefix" "$hdrf"
				if "$SHARE/parse.uc" "$raw" "$STATE/tagmap-$prefix.json" "$STATE/overrides.json" "$prefix" > "$obs" 2>/dev/null && [ -s "$obs" ]; then
					[ "$first" = 1 ] || printf ',' >> "$staged"
					printf '{"label":"%s","outbounds":' "$prefix" >> "$staged"
					cat "$obs" >> "$staged"
					printf '}' >> "$staged"
					first=0; nok=$((nok + 1))
				else
					failed="$failed $prefix"
				fi
			else
				failed="$failed $prefix"
			fi
		done
		# A subscription that could not be refetched keeps its currently installed
		# exits: snapshot them from the live config as extra staged groups. Disabled
		# subscriptions are deliberately absent here - those DO get pruned on apply.
		nsnap=0
		for pfx in $failed; do
			nsnap=$((nsnap + 1)); snap="$tmpd/snap.$nsnap"
			if "$SHARE/snapshot.uc" "$CFG" "$pfx" $(sub_prefixes) > "$snap" 2>/dev/null && [ -s "$snap" ]; then
				[ "$first" = 1 ] || printf ',' >> "$staged"
				printf '{"label":"%s","outbounds":' "$pfx" >> "$staged"
				cat "$snap" >> "$staged"
				printf '}' >> "$staged"
				first=0
			fi
		done
		printf ']}' >> "$staged"
		if [ "$nsub" -eq 0 ]; then
			echo "no-subs" > "$STATE/status"
		elif [ "$nok" -gt 0 ]; then
			mv "$staged" "$STATE/staged.json"
			"$SHARE/diff.uc" "$STATE/staged.json" "$CFG" $(sub_prefixes) -- $(diff_ignore) > "$STATE/diff.json" 2>/dev/null
			cnt=$(jsonfilter -i "$STATE/diff.json" -e '@.total' 2>/dev/null)
			[ "${cnt:-0}" -gt 0 ] && echo 1 > "$STATE/pending" || echo 0 > "$STATE/pending"
			[ "$nok" -eq "$nsub" ] && echo "ok" > "$STATE/status" || echo "partial" > "$STATE/status"
		else
			echo "fetch-error" > "$STATE/status"
		fi
		date +%s > "$STATE/last_fetch"
		rm -rf "$tmpd"
		case "$(cat "$STATE/status" 2>/dev/null)" in ok|partial) frc=0 ;; *) frc=1 ;; esac
		# auto-apply runs in-process (fetch already holds the lock)
		if [ "$auto_apply" = "1" ] && [ "$(cat "$STATE/pending" 2>/dev/null)" = "1" ]; then
			do_apply >/dev/null 2>&1 || frc=1
		fi
		exit "$frc"
		;;

	apply)
		do_apply
		;;

	status)
		lf=$(cat "$STATE/last_fetch" 2>/dev/null); st=$(cat "$STATE/status" 2>/dev/null); pending=$(cat "$STATE/pending" 2>/dev/null)
		"$SHARE/status.uc" "${lf:-0}" "${st:-never}" "${pending:-0}" "$CFG" "$STATE/diff.json" "$STATE"
		;;

	sub-add)
		valid_prefix "$2" || { echo "invalid prefix"; exit 1; }
		case "$3" in http://*|https://*) ;; *) echo "invalid url"; exit 1 ;; esac
		conf=$(prefix_conflict "$2" "") && { echo "prefix overlaps with prefix '$conf'"; exit 1; }
		sec=$(uci add xray-monitor subscription 2>/dev/null)
		uci set "xray-monitor.$sec.prefix"="$2"
		uci set "xray-monitor.$sec.url"="$3"
		uci set "xray-monitor.$sec.enabled"='1'
		uci commit xray-monitor
		echo ok
		;;

	sub-del)
		dpfx=$(uci -q get "xray-monitor.$2.prefix")
		uci -q delete "xray-monitor.$2" && uci commit xray-monitor \
			&& { [ -n "$dpfx" ] && rm -f "$STATE/usage-$dpfx.json" "$STATE/title-$dpfx.txt"; echo ok; } || { echo "delete failed"; exit 1; }
		;;

	sub-edit)  # <id> <prefix> <url> <enabled>  (empty = keep)
		uci -q get "xray-monitor.$2" >/dev/null 2>&1 || { echo "no such subscription"; exit 1; }
		if [ -n "$3" ]; then
			valid_prefix "$3" || { echo "invalid prefix"; exit 1; }
			conf=$(prefix_conflict "$3" "$2") && { echo "prefix overlaps with prefix '$conf'"; exit 1; }
			uci set "xray-monitor.$2.prefix"="$3"
		fi
		if [ -n "$4" ]; then
			case "$4" in http://*|https://*) uci set "xray-monitor.$2.url"="$4" ;; *) echo "invalid url"; exit 1 ;; esac
		fi
		[ -n "$5" ] && uci set "xray-monitor.$2.enabled"="$5"
		uci commit xray-monitor
		echo ok
		;;

	set-cfg)  # <cron> <cron_schedule> <auto_apply> <user_agent>  (empty = keep)
		uci set xray-monitor.sub=xray-monitor 2>/dev/null
		[ -n "$2" ] && uci set xray-monitor.sub.cron="$2"
		if [ -n "$3" ]; then
			[ "$(echo "$3" | wc -w)" -eq 5 ] || { echo "invalid cron schedule (need 5 fields)"; exit 1; }
			uci set xray-monitor.sub.cron_schedule="$3"
		fi
		[ -n "$4" ] && uci set xray-monitor.sub.auto_apply="$4"
		[ -n "$5" ] && uci set xray-monitor.sub.user_agent="$5"
		uci commit xray-monitor
		do_cron_sync >/dev/null 2>&1
		echo ok
		;;

	cron-sync)
		do_cron_sync
		;;

	routing-get)   "$SHARE/routing.uc" get "$CFG" ;;
	balancers-get) "$SHARE/balancers.uc" get "$CFG" ;;

	routing-set|balancers-set)
		[ -s "$2" ] || { echo "no input"; exit 1; }
		case "$1" in routing-set) uc="$SHARE/routing.uc" ;; *) uc="$SHARE/balancers.uc" ;; esac
		api_before=0; api_up && api_before=1
		stage_init
		if "$uc" set "$CFG" "$2" "$STAGE_DIR/config.json" $(sub_prefixes) >/dev/null 2>&1 \
			&& test_config "$STAGE_DIR/config.json"; then
			bak="$CFG.bak.$(date +%Y%m%d-%H%M%S)"; cp -a "$CFG" "$bak"
			install_config "$STAGE_DIR/config.json" || { echo "failed to install new config"; exit 1; }
			/etc/init.d/xray restart >/dev/null 2>&1
			if verify_or_rollback "$bak" "$api_before"; then prune_backups; echo ok
			else echo "xray/api failed health check - rolled back"; exit 1; fi
		else
			echo "config test failed - not applied"; exit 1
		fi
		;;

	config-save)
		[ -s "$2" ] || { echo "empty config"; exit 1; }
		test_config "$2" || { echo "xray -test failed; not saved"; exit 1; }
		bak="$CFG.bak.manual.$(date +%Y%m%d-%H%M%S)"; cp -a "$CFG" "$bak"
		install_config "$2" || { echo "failed to install new config"; exit 1; }
		/etc/init.d/xray restart >/dev/null 2>&1
		if verify_or_rollback "$bak" 0; then
			prune_backups
			echo "saved and restarted xray"
		else
			echo "saved but xray failed to start - rolled back"; exit 1
		fi
		;;

	latest-version)
		curl -s --max-time 15 "$FEED/Packages" 2>/dev/null | sed -n 's/^Version: //p' | tail -n1
		;;

	self-update)
		tmp="/tmp/luci-app-xray-monitor.ipk"
		# 1) preferred: stable GitHub Release asset (single redirect, robust)
		if curl -fsSL --max-time 60 -o "$tmp" "$REL" 2>/dev/null && tar -tzf "$tmp" >/dev/null 2>&1; then
			src=release
		else
			# 2) fallback: the opkg feed
			ipk=$(curl -s --max-time 15 "$FEED/Packages" 2>/dev/null | sed -n 's/^Filename: //p' | tail -n1)
			[ -n "$ipk" ] || { rm -f "$tmp"; echo "cannot reach Releases or feed"; exit 1; }
			curl -s --max-time 60 -o "$tmp" "$FEED/$ipk" || { rm -f "$tmp"; echo "download failed"; exit 1; }
			tar -tzf "$tmp" >/dev/null 2>&1 || { rm -f "$tmp"; echo "downloaded file is not a valid package (feed may be updating)"; exit 1; }
			src=feed
		fi
		# Integrity gate: verify the download against a published checksum
		# before handing it to opkg. Preferred: the .sha256 sidecar next to
		# the Release asset; else the SHA256sum of the matching Version
		# stanza in the feed index. Neither available, or mismatch => refuse.
		exp=""
		if [ "$src" = release ]; then
			exp=$(curl -fsSL --max-time 20 "$REL.sha256" 2>/dev/null | awk 'NR==1 { print $1 }')
		fi
		if [ -z "$exp" ]; then
			ver=$(tar -xzOf "$tmp" ./control.tar.gz 2>/dev/null | tar -xzO ./control 2>/dev/null | sed -n 's/^Version: //p' | head -n1)
			[ -n "$ver" ] || { rm -f "$tmp"; echo "cannot read package version - refusing to install"; exit 1; }
			exp=$(curl -s --max-time 20 "$FEED/Packages" 2>/dev/null | awk -v want="$ver" '
				/^Package: /    { ok = ($2 == PKG) }
				/^Version: /    { ok = ok && ($2 == want) }
				/^SHA256sum: /  { if (ok) { print $2; exit } }' PKG="$PKG")
		fi
		[ -n "$exp" ] || { rm -f "$tmp"; echo "no published SHA256 for this package version - refusing to install"; exit 1; }
		got=$(sha256sum "$tmp" 2>/dev/null | awk '{ print $1 }')
		[ "$got" = "$exp" ] || { rm -f "$tmp"; echo "SHA256 mismatch (expected $exp, got $got) - refusing to install"; exit 1; }
		opkg install --force-reinstall "$tmp"; rc=$?
		rm -f "$tmp"
		[ "$rc" -eq 0 ] && echo "updated" || { echo "opkg install failed"; exit 1; }
		;;

	enable-api)
		command -v ucode >/dev/null 2>&1 || { echo "ucode not installed"; exit 1; }
		ucode -e 'import { readfile } from "fs";' >/dev/null 2>&1 || { echo "ucode-mod-fs not installed"; exit 1; }
		[ -f "$CFG" ] || { echo "xray config not found at $CFG"; exit 1; }
		stage_init
		res=$("$SHARE/enable-api.uc" "$CFG" "$STAGE_DIR/config.json" 10085 $(sub_prefixes) 2>&1)
		case "$res" in
			unchanged) echo "already enabled ($CFG)"; exit 0 ;;
			changed)   ;;
			*)         echo "merge failed: $res"; exit 1 ;;
		esac
		test_config "$STAGE_DIR/config.json" || { echo "xray -test failed on merged config; not applied"; exit 1; }
		bak="$CFG.bak.preapi.$(date +%Y%m%d-%H%M%S)"; cp -a "$CFG" "$bak"
		install_config "$STAGE_DIR/config.json" || { echo "failed to install new config"; exit 1; }
		/etc/init.d/xray restart >/dev/null 2>&1
		if verify_or_rollback "$bak" 1; then
			prune_backups
			echo "enabled and restarted xray ($CFG)"
		else
			echo "enabled but stats API did not come up - rolled back"; exit 1
		fi
		;;

	*)
		echo "usage: xray-sub fetch|apply|status|set-cfg ...|cron-sync|sub-add|sub-del|sub-edit|routing-get|routing-set <f>|balancers-get|balancers-set <f>|config-save <f>|enable-api"; exit 1 ;;
esac
