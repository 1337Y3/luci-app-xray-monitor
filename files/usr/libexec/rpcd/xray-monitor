#!/bin/sh
# rpcd backend for luci-app-xray-monitor
# ubus object: xray-monitor   methods: status, stats, outbounds
. /usr/share/libubox/jshn.sh

XRAY="/usr/bin/xray"
API_SERVER="127.0.0.1:10085"

# Resolve the active xray config file (for endpoint discovery)
config_file() {
	local f
	f=$(uci -q get xray.config.conffiles 2>/dev/null | awk '{print $1}')
	[ -f "$f" ] && { echo "$f"; return; }
	echo "/etc/xray/config.json"
}

# Detect the config double-load footgun: xray launched with -confdir D *and*
# -config F where F lives inside D, so D/*.json loads F a second time. Harmless
# until it isn't (inbounds, incl. the api on 10085, can fail to bind).
confdir_dup() {
	local pid="$1" tok prev confdirs="" configs="" d f
	[ -n "$pid" ] && [ -r "/proc/$pid/cmdline" ] || return 1
	prev=""
	while IFS= read -r tok; do
		case "$prev" in
			-confdir|--confdir) confdirs="$confdirs $tok" ;;
			-config|--config)   configs="$configs $tok" ;;
		esac
		case "$tok" in
			-confdir=*|--confdir=*) confdirs="$confdirs ${tok#*=}" ;;
			-config=*|--config=*)   configs="$configs ${tok#*=}" ;;
		esac
		prev="$tok"
	done <<EOF
$(tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null)
EOF
	[ -n "$confdirs" ] && [ -n "$configs" ] || return 1
	for f in $configs; do
		for d in $confdirs; do
			[ "$(dirname "$f")" = "${d%/}" ] && return 0
		done
	done
	return 1
}

# Which API services the CONFIG declares, so the UI can tell "not enabled"
# from "enabled but down" without poking the API. Keep the required list in
# sync with enable-api.uc. Sets api_services (config order, deduped) and
# api_missing (required services absent from the config).
API_SERVICES="StatsService HandlerService RoutingService"
get_api_services() {  # -> api_services, api_missing
	local cfg s x
	api_services=""; api_missing=""
	cfg=$(config_file)
	[ -s "$cfg" ] || { api_missing="$API_SERVICES"; return; }
	s=$(jsonfilter -i "$cfg" -e '@.api.services[*]' 2>/dev/null)
	for x in $s; do
		case " $api_services " in *" $x "*) ;; *) api_services="$api_services $x" ;; esac
	done
	# compare against the deduped, space-separated api_services, not $s:
	# jsonfilter prints one service per line, so a " $s " pattern match would
	# never see the space after a name and every service would read "missing"
	for x in $API_SERVICES; do
		case " $api_services " in *" $x "*) ;; *) api_missing="$api_missing $x" ;; esac
	done
}

get_status() {
	local pid hz starttime sysuptime up=0 running=0 version
	pid=$(pgrep -f "$XRAY run" | head -n1)
	version=$($XRAY version 2>/dev/null | head -n1)
	if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
		running=1
		hz=$(getconf CLK_TCK 2>/dev/null)
		[ -n "$hz" ] || hz=100
		starttime=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null)
		sysuptime=$(awk '{print int($1)}' /proc/uptime 2>/dev/null)
		if [ -n "$starttime" ] && [ -n "$sysuptime" ]; then
			up=$(( sysuptime - starttime / hz ))
			[ "$up" -lt 0 ] && up=0
		fi
	fi
	get_api_services
	json_init
	json_add_boolean running "$running"
	json_add_int pid "${pid:-0}"
	json_add_int uptime "$up"
	json_add_string version "${version:-unknown}"
	json_add_string app_version "$(opkg status luci-app-xray-monitor 2>/dev/null | sed -n 's/^Version: //p' | head -n1)"
	json_add_boolean confdir_dup "$(confdir_dup "$pid" && echo 1 || echo 0)"
	json_add_array "api_services"
	for x in $api_services; do json_add_string "" "$x"; done
	json_close_array
	json_add_array "api_missing"
	for x in $api_missing; do json_add_string "" "$x"; done
	json_close_array
	json_dump
}

get_stats() {
	local out
	out=$($XRAY api statsquery --server="$API_SERVER" 2>/dev/null)
	case "$out" in
		\{*) printf '%s' "$out" ;;
		*)   printf '{"stat":[]}' ;;
	esac
}

# TCP-reachability probe -> echoes "<up> <ms>"  (up: 1 reachable, 0 down, -1 no tool)
# Backends, most precise first, detected once per call:
#   ucode-mod-socket  bare TCP connect (no payload, no handshake) + ms latency
#   curl ftp://       connect, then wait for a server greeting that never comes
#                     - not a single byte is sent to the endpoint. Up is judged
#                     by time_connect > 0 (the later timeout rc is expected);
#                     bounded by --max-time. (telnet:// is not compiled into
#                     OpenWrt's curl.)
#   ncat -z           port check, no latency value
# ucode-mod-socket is optional and only exists in the feeds from 24.10 on, so
# 23.05 boxes transparently use the curl path. BusyBox nc has no -w and can
# hang in connect() for minutes, so it is deliberately not used.
have_socket=0
if command -v ucode >/dev/null 2>&1; then
	ucode -e 'import { create } from "socket";' >/dev/null 2>&1 && have_socket=1
fi
have_curl=0; command -v curl >/dev/null 2>&1 && have_curl=1
have_ncat=0; command -v ncat >/dev/null 2>&1 && have_ncat=1

probe() {
	local a="$1" p="$2" out url t rc
	if [ "$have_socket" = 1 ]; then
		# probe.uc aborts with empty output on refused/unreachable => down
		out=$("$SHARE/probe.uc" "$a" "$p" 2>/dev/null)
		[ -n "$out" ] && echo "$out" || echo "0 0"
		return
	fi
	if [ "$have_curl" = 1 ]; then
		case "$a" in *:*) url="ftp://[$a]:$p" ;; *) url="ftp://$a:$p" ;; esac
		t=$(curl -s -o /dev/null </dev/null --connect-timeout 3 --max-time 3 \
			-w '%{time_connect}' "$url" 2>/dev/null); rc=$?
		if [ "$rc" -eq 1 ]; then
			have_curl=0   # protocol unsupported by this curl build - skip it
		else
			t=$(awk "BEGIN{printf \"%.0f %d\", (${t:-0})*1000, (${t:-0} > 0) ? 1 : 0}")
			[ "${t#* }" = 1 ] && echo "1 ${t% *}" || echo "0 0"
			return
		fi
	fi
	if [ "$have_ncat" = 1 ]; then
		ncat -z -w 3 "$a" "$p" >/dev/null 2>&1 && echo "1 0" || echo "0 0"
		return
	fi
	echo "-1 0"
}

# Print an IPv6 address the way /proc/net/nf_conntrack spells dst=: eight
# groups of 4 zero-padded hex digits, no "::" compression, e.g.
# 2a01:4f8::1 -> 2a01:04f8:0000:0000:0000:0000:0000:0001. grep needs that
# exact form - the compressed spelling never matches a conntrack line.
expand6() {  # <ipv6>
	local a="$1" pre post g n=0 preout="" postout=""
	case "$a" in
		*.*)  echo "$a"; return ;;   # IPv4-mapped/junk - leave as-is
		*::*) pre="${a%%::*}"; post="${a##*::}" ;;
		*)    pre="$a"; post="" ;;
	esac
	local IFS=:
	for g in $pre; do
		case "$g" in *[!0-9a-fA-F]*|'') echo "$a"; return ;; esac
		preout="$preout$(printf '%04x:' $(( 0x$g )))"; n=$((n + 1))
	done
	for g in $post; do
		case "$g" in *[!0-9a-fA-F]*|'') echo "$a"; return ;; esac
		postout="$postout$(printf '%04x:' $(( 0x$g )))"; n=$((n + 1))
	done
	[ "$n" -gt 8 ] && { echo "$a"; return; }   # not 8-expandable - keep as-is
	while [ "$n" -lt 8 ]; do postout="0000:$postout"; n=$((n + 1)); done
	local out="${preout}${postout}"
	echo "${out%:}"
}

# Is there a live (ESTABLISHED) connection to addr:port right now?
# Resolves hostnames to IPs (subscription servers use hostnames), preferring
# A over AAAA; IPv6 literals and AAAA results are normalized via expand6().
is_active() {
	local addr="$1" port="$2" ips ip
	case "$addr" in
		*:*)        ips=$(expand6 "$addr") ;;                 # IPv6 literal
		*[!0-9.]*)                                              # hostname
			ips=$(resolveip -4 -t 2 "$addr" 2>/dev/null)
			if [ -z "$ips" ]; then
				ips=$(resolveip -6 -t 2 "$addr" 2>/dev/null \
					| while IFS= read -r ip; do expand6 "$ip"; done)
			fi
			;;
		*)          ips="$addr" ;;
	esac
	[ -n "$ips" ] || ips="$addr"
	for ip in $ips; do
		grep "ESTABLISHED" /proc/net/nf_conntrack 2>/dev/null \
			| grep "dst=$ip " | grep -q "dport=$port " && return 0
	done
	return 1
}

# Tags the user has turned off from the active TCP probe ("ping check"), so a
# blown/blocked endpoint isn't poked (its handshake can trigger an ISP reset).
# Stored as a UCI list; matched with surrounding spaces so substrings don't hit.
probe_disabled_list() {
	printf ' %s ' "$(uci -q get xray-monitor.sub.probe_disabled 2>/dev/null)"
}

get_outbounds() {
	local cfg n i tag addr port up ms active dis dlist tmp f
	cfg=$(config_file)
	dlist=$(probe_disabled_list)
	n=$(jsonfilter -i "$cfg" -e '@.outbounds[*].tag' 2>/dev/null | wc -l)
	tmp=$(mktemp -d) || { json_init; json_add_array "outbounds"; json_close_array; json_dump; return; }
	i=0
	while [ "$i" -lt "$n" ]; do
		tag=$(jsonfilter -i "$cfg" -e "@.outbounds[$i].tag" 2>/dev/null)
		addr=$(jsonfilter -i "$cfg" -e "@.outbounds[$i].settings.vnext[0].address" 2>/dev/null)
		port=$(jsonfilter -i "$cfg" -e "@.outbounds[$i].settings.vnext[0].port" 2>/dev/null)
		[ -n "$addr" ] || addr=$(jsonfilter -i "$cfg" -e "@.outbounds[$i].settings.servers[0].address" 2>/dev/null)
		[ -n "$port" ] || port=$(jsonfilter -i "$cfg" -e "@.outbounds[$i].settings.servers[0].port" 2>/dev/null)
		case "$dlist" in *" $tag "*) dis=1 ;; *) dis=0 ;; esac
		if [ -n "$addr" ] && [ -n "$port" ]; then
			(
				if [ "$dis" = 1 ]; then
					up=-2; ms=0   # -2 = probe disabled by user
				else
					set -- $(probe "$addr" "$port"); up="$1"; ms="$2"
				fi
				# is_active only reads /proc/net/nf_conntrack (passive), so it's
				# safe to keep even for a disabled endpoint — no packet is sent.
				active=0; is_active "$addr" "$port" && active=1
				printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$tag" "$addr" "$port" "$up" "$ms" "$active" "$dis" \
					> "$tmp/$(printf '%03d' "$i")"
			) &
		fi
		i=$((i + 1))
	done
	wait

	json_init
	json_add_array "outbounds"
	for f in "$tmp"/*; do
		[ -f "$f" ] || continue
		IFS='	' read -r tag addr port up ms active dis < "$f"
		json_add_object
		json_add_string tag "$tag"
		json_add_string addr "$addr"
		json_add_int port "$port"
		json_add_int up "$up"
		json_add_int ms "$ms"
		json_add_boolean active "$active"
		json_add_boolean disabled "$dis"
		json_close_object
	done
	json_close_array
	json_dump
	rm -rf "$tmp"
}

# Turn the active probe on/off for one outbound tag. Idempotent + dedupes.
do_probe_set() {
	local input tag dis cur t
	input=$(cat)
	tag=$(echo "$input" | jsonfilter -e '@.tag' 2>/dev/null)
	dis=$(echo "$input" | jsonfilter -e '@.disabled' 2>/dev/null)
	if [ -z "$tag" ]; then
		json_init; json_add_boolean ok 0; json_add_string msg "missing tag"; json_dump; return
	fi
	uci -q get xray-monitor.sub >/dev/null 2>&1 || uci set xray-monitor.sub=xray-monitor
	cur=$(uci -q get xray-monitor.sub.probe_disabled 2>/dev/null)
	uci -q delete xray-monitor.sub.probe_disabled 2>/dev/null
	for t in $cur; do
		[ "$t" = "$tag" ] && continue
		uci add_list xray-monitor.sub.probe_disabled="$t"
	done
	[ "$dis" = 1 ] && uci add_list xray-monitor.sub.probe_disabled="$tag"
	uci commit xray-monitor
	json_init; json_add_boolean ok 1; json_dump
}

# Cheap metadata for the UI's first paint and for toggling without probing:
# every probeable outbound tag + whether it's disabled. No network probe, so it
# returns instantly (the slow per-exit connectivity comes from `outbounds`).
get_outmeta() {
	local cfg n i tag addr port dis dlist
	cfg=$(config_file)
	dlist=$(probe_disabled_list)
	n=$(jsonfilter -i "$cfg" -e '@.outbounds[*].tag' 2>/dev/null | wc -l)
	json_init
	json_add_array "outbounds"
	i=0
	while [ "$i" -lt "$n" ]; do
		tag=$(jsonfilter -i "$cfg" -e "@.outbounds[$i].tag" 2>/dev/null)
		addr=$(jsonfilter -i "$cfg" -e "@.outbounds[$i].settings.vnext[0].address" 2>/dev/null)
		port=$(jsonfilter -i "$cfg" -e "@.outbounds[$i].settings.vnext[0].port" 2>/dev/null)
		[ -n "$addr" ] || addr=$(jsonfilter -i "$cfg" -e "@.outbounds[$i].settings.servers[0].address" 2>/dev/null)
		[ -n "$port" ] || port=$(jsonfilter -i "$cfg" -e "@.outbounds[$i].settings.servers[0].port" 2>/dev/null)
		if [ -n "$addr" ] && [ -n "$port" ]; then
			case "$dlist" in *" $tag "*) dis=1 ;; *) dis=0 ;; esac
			json_add_object
			json_add_string tag "$tag"
			json_add_boolean disabled "$dis"
			json_close_object
		fi
		i=$((i + 1))
	done
	json_close_array
	json_dump
}

# Reset all traffic counters to zero (reads+resets via the Stats API)
do_reset() {
	local rc
	$XRAY api statsquery --server="$API_SERVER" -reset >/dev/null 2>&1
	rc=$?
	json_init
	json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"
	json_dump
}

SHARE=/usr/share/xray-monitor
SUB=$SHARE/xray-sub

# --- Balancers: live state + sticky overrides (F15) ---------------------------
# `xray api bi/bo` talk to the RoutingService on the api inbound (loopback
# only; enable-api.uc ships it). Every call carries xray's own -t flag, so a
# down API fails after ~2 s instead of hanging the ubus call. bi is read-only;
# bo mutates the RUNNING instance only - config.json is never touched here,
# overrides persist in UCI (xray-sub overrides-*) and survive restarts via
# post_restart_hooks.

# Live snapshot for the Balancers tab: one `bi` call per configured balancer
# (in parallel, so wall time stays one call even for several balancers) plus
# the persisted overrides, merged by balance-cli.uc into the shape the UI
# renders (pick / running pin / saved pin / divergence per balancer).
get_balancers_live() {
	local cfg tmp t ts out
	cfg=$(config_file)
	if ! command -v ucode >/dev/null 2>&1 || [ ! -s "$cfg" ]; then
		printf '{"api":false,"balancers":[],"stale":[],"ts":0}'
		return
	fi
	tmp=$(mktemp -d) || { printf '{"api":false,"balancers":[],"stale":[],"ts":0}'; return; }
	for t in $(jsonfilter -i "$cfg" -e '@.routing.balancers[*].tag' 2>/dev/null); do
		# the tag becomes a filename below: strict charset, never "." / ".."
		case "$t" in ''|.|..|*[!A-Za-z0-9._-]*) continue ;; esac
		(
			out=$("$XRAY" api bi --server="$API_SERVER" -t 2 -json "$t" 2>/dev/null)
			if [ $? -eq 0 ] && [ -n "$out" ]; then printf '%s' "$out" > "$tmp/$t.bi"
			else printf '{"error":true}' > "$tmp/$t.bi"; fi
		) &
	done
	wait
	"$SUB" overrides-list > "$tmp/overrides.json" 2>/dev/null || printf '[]' > "$tmp/overrides.json"
	ts=$(date +%s)
	"$SHARE/balance-cli.uc" live "$cfg" "$tmp" "$tmp/overrides.json" "$ts" \
		|| printf '{"api":false,"balancers":[],"stale":[],"ts":%s}' "$ts"
	rm -rf "$tmp"
}

# Upsert the UCI side of an override: exactly one balancer_override section per
# balancer (set the outbound on the existing one, drop accidental duplicates,
# else add a section).
override_upsert_uci() {  # <balancer> <outbound>
	local id keep="" b
	for id in $(uci show xray-monitor 2>/dev/null | sed -n 's/^xray-monitor\.\([^.]*\)=balancer_override$/\1/p'); do
		b=$(uci -q get "xray-monitor.$id.balancer")
		[ "$b" = "$1" ] || continue
		if [ -z "$keep" ]; then
			uci set "xray-monitor.$id.outbound"="$2"; keep="$id"
		else
			uci -q delete "xray-monitor.$id"
		fi
	done
	if [ -z "$keep" ]; then
		keep=$(uci add xray-monitor balancer_override)
		uci set "xray-monitor.$keep.balancer"="$1"
		uci set "xray-monitor.$keep.outbound"="$2"
	fi
}

# Pin one balancer to one outbound: validate (charset AND membership in the
# current config - bo would accept a nonexistent tag and the balancer would
# route into the void), apply LIVE via bo, then persist. bo first: a failure
# (api down, balancer just vanished) must not leave a UCI section the running
# xray does not honor.
do_override_set() {
	local input bal ob v ok msg rc
	input=$(cat)
	bal=$(echo "$input" | jsonfilter -e '@.balancer' 2>/dev/null)
	ob=$(echo "$input"  | jsonfilter -e '@.outbound' 2>/dev/null)
	if [ -z "$bal" ] || [ -z "$ob" ]; then
		json_init; json_add_boolean ok 0; json_add_string msg "missing balancer or outbound"; json_dump; return
	fi
	v=$("$SHARE/balance-cli.uc" validate "$(config_file)" "$bal" "$ob" 2>/dev/null)
	ok=$(printf '%s' "$v" | jsonfilter -e '@.ok' 2>/dev/null)
	if [ "$ok" != 1 ]; then
		msg=$(printf '%s' "$v" | jsonfilter -e '@.msg' 2>/dev/null)
		[ -n "$msg" ] || msg="invalid override"
		json_init; json_add_boolean ok 0; json_add_string msg "$msg"; json_dump; return
	fi
	msg=$("$XRAY" api bo --server="$API_SERVER" -t 2 -b "$bal" "$ob" 2>&1); rc=$?
	if [ "$rc" -ne 0 ]; then
		json_init; json_add_boolean ok 0
		json_add_string msg "xray rejected the override: $(printf '%s' "$msg" | tr -s '\r\n\t ' ' ')"
		json_dump; return
	fi
	override_upsert_uci "$bal" "$ob"
	uci commit xray-monitor
	json_init; json_add_boolean ok 1; json_add_string msg "pinned $bal to $ob"; json_dump
}

# Remove a balancer's sticky override: clear the LIVE pin first - even when no
# UCI section exists (it may have been set from the CLI). A bo failure is
# tolerated when the balancer is gone from the config: that is exactly the
# stale-section case, where dropping the section is the whole point.
do_override_del() {
	local input bal id b
	input=$(cat)
	bal=$(echo "$input" | jsonfilter -e '@.balancer' 2>/dev/null)
	case "$bal" in
		''|*[!A-Za-z0-9._-]*)
			json_init; json_add_boolean ok 0; json_add_string msg "missing or invalid balancer"; json_dump
			return ;;
	esac
	"$XRAY" api bo --server="$API_SERVER" -t 2 -b "$bal" -r >/dev/null 2>&1
	for id in $(uci show xray-monitor 2>/dev/null | sed -n 's/^xray-monitor\.\([^.]*\)=balancer_override$/\1/p'); do
		b=$(uci -q get "xray-monitor.$id.balancer")
		if [ "$b" = "$bal" ]; then uci -q delete "xray-monitor.$id"; fi
	done
	uci commit xray-monitor
	json_init; json_add_boolean ok 1; json_add_string msg "override removed from $bal"; json_dump
}

# Every xray-sub call from here serves a UI click: fail fast on a busy lock
# instead of waiting out xray-sub's ~55 s poll inside the rpcd call (the HTTP
# session may drop while the operation would still run afterwards). The cron
# path invokes xray-sub without this variable and keeps the bounded wait.
export XRAYMON_NOWAIT=1

sub_msg() {  # <args...> — run xray-sub, emit {"ok":bool,"msg":string}
	local msg rc
	msg=$("$SUB" "$@" 2>&1); rc=$?
	json_init
	json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"
	json_add_string msg "$msg"
	json_dump
}

# --- config.json backups (xray-sub backups-*) --------------------------------
# The client sends only a backup basename. It must be a plain basename, be
# present in the real listing of $CFG.bak.* files, and be pipeline-shaped;
# the path is always rebuilt from the config file's own directory, so no
# client path ever reaches the filesystem. Mirrors backup_path() in xray-sub
# (defense in depth), including the shape check - config_diff never reaches
# xray-sub, so this is the only gate for it.
backup_check() {  # <basename> -> prints path, rc 1 = rejected
	local cfg d b pfx rest
	case "$1" in
		''|*[!A-Za-z0-9._-]*) return 1 ;;
	esac
	cfg=$(config_file)
	d=$(dirname "$cfg")
	for b in $(ls -t "$d/$(basename "$cfg").bak."* 2>/dev/null); do
		if [ "${b##*/}" = "$1" ]; then
			# same shape rules as backup_meta() in xray-sub:
			# [pinned.][manual.|preapi.]<timestamp>
			pfx="$(basename "$cfg").bak."
			rest="$1"
			case "$rest" in "$pfx"*) rest="${rest#"$pfx"}" ;; *) return 1 ;; esac
			case "$rest" in pinned.*) rest="${rest#pinned.}" ;; esac
			case "$rest" in manual.*|preapi.*) rest="${rest#*.}" ;; esac
			case "$rest" in
				20[0-9][0-9][01][0-9][0-3][0-9]-[0-2][0-9][0-5][0-9][0-5][0-9]) ;;
				*) return 1 ;;
			esac
			echo "$d/$1"; return 0
		fi
	done
	return 1
}

# Validate the live xray config with `xray -test` (read-only)
do_validate() {
	local cfg out rc msg
	cfg=$(config_file)
	out=$($XRAY -test -format json -config "$cfg" 2>&1); rc=$?
	msg=$(printf '%s\n' "$out" | grep -viE '^Xray [0-9]|Penetrates Everything|unified platform|infra/conf/serial: Reading' | tr -s '\r\n\t ' ' ')
	json_init
	json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"
	json_add_string config "$cfg"
	json_add_string msg "${msg:-no output}"
	json_dump
}

case "$1" in
	list)
		json_init
		json_add_object "status";     json_close_object
		json_add_object "stats";      json_close_object
		json_add_object "outbounds";  json_close_object
		json_add_object "out_meta";   json_close_object
		json_add_object "probe_set"; json_add_string "tag" ""; json_add_string "disabled" ""; json_close_object
		json_add_object "reset";      json_close_object
		json_add_object "sub_get";    json_close_object
		json_add_object "sub_fetch";  json_close_object
		json_add_object "sub_apply";  json_close_object
		json_add_object "sub_setcfg"
			json_add_string "cron" ""; json_add_string "cron_schedule" ""
			json_add_string "auto_apply" ""; json_add_string "user_agent" ""
			json_add_string "hot_swap" ""
		json_close_object
		json_add_object "sub_add"; json_add_string "prefix" ""; json_add_string "url" ""; json_close_object
		json_add_object "sub_del"; json_add_string "id" ""; json_close_object
		json_add_object "sub_edit"
			json_add_string "id" ""; json_add_string "prefix" ""
			json_add_string "url" ""; json_add_string "enabled" ""
		json_close_object
		json_add_object "routing_get"; json_close_object
		json_add_object "routing_set"; json_add_array "inbounds"; json_close_array; json_close_object
		json_add_object "balancers_get"; json_close_object
		json_add_object "balancers_set"; json_add_array "balancers"; json_close_array; json_close_object
		json_add_object "balancers_live"; json_close_object
		json_add_object "balancer_override_set"
			json_add_string "balancer" ""; json_add_string "outbound" ""
		json_close_object
		json_add_object "balancer_override_del"; json_add_string "balancer" ""; json_close_object
		json_add_object "balancer_override_apply"; json_close_object
		json_add_object "enable_api"; json_close_object
		json_add_object "validate"; json_close_object
		json_add_object "config_get"; json_close_object
		json_add_object "config_test"; json_add_string "config" ""; json_close_object
		json_add_object "config_save"; json_add_string "config" ""; json_close_object
		json_add_object "update_check"; json_close_object
		json_add_object "update_apply"; json_close_object
		json_add_object "backups_list"; json_close_object
		json_add_object "backups_get"; json_add_string "name" ""; json_close_object
		json_add_object "backups_delete"; json_add_string "name" ""; json_close_object
		json_add_object "backups_pin"; json_add_string "name" ""; json_add_string "pinned" ""; json_close_object
		json_add_object "backups_restore"; json_add_string "name" ""; json_close_object
		json_add_object "config_diff"; json_add_string "name" ""; json_close_object
		json_dump
	;;
	call)
		case "$2" in
			status)    get_status ;;
			stats)     get_stats ;;
			outbounds) get_outbounds ;;
			out_meta)  get_outmeta ;;
			probe_set) do_probe_set ;;
			reset)     do_reset ;;
			validate)  do_validate ;;
			config_get)
				cfg=$(config_file)
				json_init
				json_add_string path "$cfg"
				json_add_string config "$(cat "$cfg" 2>/dev/null)"
				json_dump
			;;
			config_test)
				input=$(cat)
				tmp=$(mktemp -d)
				if [ -z "$tmp" ] || [ ! -d "$tmp" ]; then
					json_init; json_add_boolean ok 0; json_add_string msg "cannot create temp dir"; json_dump
				else
					tmp="$tmp/config.json"
					printf '%s' "$input" | jsonfilter -e '@.config' > "$tmp" 2>/dev/null
					out=$($XRAY -test -format json -config "$tmp" 2>&1); rc=$?
					rm -rf "${tmp%/*}"
					msg=$(printf '%s\n' "$out" | grep -viE '^Xray [0-9]|Penetrates Everything|unified platform|infra/conf/serial: Reading' | tr -s '\r\n\t ' ' ')
					json_init
					json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"
					json_add_string msg "${msg:-no output}"
					json_dump
				fi
			;;
			config_save)
				input=$(cat)
				tmp=$(mktemp -d)
				if [ -z "$tmp" ] || [ ! -d "$tmp" ]; then
					json_init; json_add_boolean ok 0; json_add_string msg "cannot create temp dir"; json_dump
				else
					tmp="$tmp/config.json"
					printf '%s' "$input" | jsonfilter -e '@.config' > "$tmp" 2>/dev/null
					msg=$("$SUB" config-save "$tmp" 2>&1); rc=$?
					rm -rf "${tmp%/*}"
					json_init
					json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"
					json_add_string msg "$msg"
					json_dump
				fi
			;;
			sub_get)   "$SUB" status ;;
			sub_fetch) sub_msg fetch ;;
			sub_apply) sub_msg apply ;;
			sub_setcfg)
				input=$(cat)
				c=$(echo "$input"  | jsonfilter -e '@.cron' 2>/dev/null)
				s=$(echo "$input"  | jsonfilter -e '@.cron_schedule' 2>/dev/null)
				a=$(echo "$input"  | jsonfilter -e '@.auto_apply' 2>/dev/null)
				ug=$(echo "$input" | jsonfilter -e '@.user_agent' 2>/dev/null)
				hs=$(echo "$input" | jsonfilter -e '@.hot_swap' 2>/dev/null)
				msg=$("$SUB" set-cfg "$c" "$s" "$a" "$ug" "$hs" 2>&1); rc=$?
				json_init; json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"; json_add_string msg "$msg"; json_dump
			;;
			sub_add)
				input=$(cat)
				p=$(echo "$input" | jsonfilter -e '@.prefix' 2>/dev/null)
				u=$(echo "$input" | jsonfilter -e '@.url' 2>/dev/null)
				msg=$("$SUB" sub-add "$p" "$u" 2>&1); rc=$?
				json_init; json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"; json_add_string msg "$msg"; json_dump
			;;
			sub_del)
				input=$(cat)
				id=$(echo "$input" | jsonfilter -e '@.id' 2>/dev/null)
				msg=$("$SUB" sub-del "$id" 2>&1); rc=$?
				json_init; json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"; json_add_string msg "$msg"; json_dump
			;;
			sub_edit)
				input=$(cat)
				id=$(echo "$input" | jsonfilter -e '@.id' 2>/dev/null)
				p=$(echo "$input"  | jsonfilter -e '@.prefix' 2>/dev/null)
				u=$(echo "$input"  | jsonfilter -e '@.url' 2>/dev/null)
				en=$(echo "$input" | jsonfilter -e '@.enabled' 2>/dev/null)
				msg=$("$SUB" sub-edit "$id" "$p" "$u" "$en" 2>&1); rc=$?
				json_init; json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"; json_add_string msg "$msg"; json_dump
			;;
			routing_get) "$SUB" routing-get ;;
			routing_set)
				input=$(cat)
				f=$(mktemp)
				if [ -z "$f" ] || [ ! -f "$f" ]; then
					json_init; json_add_boolean ok 0; json_add_string msg "cannot create temp file"; json_dump
				else
					echo "$input" | jsonfilter -e '@.inbounds' > "$f" 2>/dev/null
					msg=$("$SUB" routing-set "$f" 2>&1); rc=$?
					rm -f "$f"
					json_init
					json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"
					json_add_string msg "$msg"
					json_dump
				fi
			;;
			enable_api)
				msg=$("$SUB" enable-api 2>&1); rc=$?
				json_init
				json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"
				json_add_string msg "$msg"
				json_dump
			;;
			update_check)
				installed=$(opkg status luci-app-xray-monitor 2>/dev/null | sed -n 's/^Version: //p' | head -n1)
				latest=$("$SUB" latest-version 2>/dev/null)
				json_init
				json_add_string installed "${installed:-unknown}"
				json_add_string latest "${latest:-}"
				json_add_boolean update_available "$([ -n "$latest" ] && [ "$latest" != "$installed" ] && echo 1 || echo 0)"
				json_dump
			;;
			update_apply)
				# Detach so the rpcd restart during opkg install can't kill the
				# update. setsid is deliberately NOT used: busybox builds without
				# that applet exist (this 23.05 box has none - the same reason
				# the tmpxray watchdog falls back to a plain background shell),
				# and `setsid: not found` would leave the button dead. Ignoring
				# SIGHUP covers the caller's death. The detached shell also
				# drops XRAYMON_NOWAIT (exported above for every xray-sub call
				# from this backend): the package postinst runs `xray-sub
				# cron-sync` and `enable-api`, which take the same mutation
				# lock - with NOWAIT inherited they would fail fast whenever a
				# cron fetch happened to hold it.
				sh -c 'trap "" HUP; unset XRAYMON_NOWAIT; sleep 2; exec /usr/share/xray-monitor/xray-sub self-update' \
					>/tmp/xraymon-update.log 2>&1 </dev/null &
				json_init
				json_add_boolean ok 1
				json_add_string msg "Update started; the page will reconnect in a few seconds."
				json_dump
			;;
			balancers_get) "$SUB" balancers-get ;;
			balancers_live) get_balancers_live ;;
			balancer_override_set) do_override_set ;;
			balancer_override_del) do_override_del ;;
			# re-apply every persisted override to the running xray (bo);
			# serialized with config writes by the mutation lock inside
			# xray-sub (fail-fast here: a UI click must not sit out the poll)
			balancer_override_apply) sub_msg overrides-apply ;;
			balancers_set)
				input=$(cat)
				f=$(mktemp)
				if [ -z "$f" ] || [ ! -f "$f" ]; then
					json_init; json_add_boolean ok 0; json_add_string msg "cannot create temp file"; json_dump
				else
					echo "$input" | jsonfilter -e '@.balancers' > "$f" 2>/dev/null
					msg=$("$SUB" balancers-set "$f" 2>&1); rc=$?
					rm -f "$f"
					json_init
					json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"
					json_add_string msg "$msg"
					json_dump
				fi
			;;
			backups_list) "$SUB" backups-list ;;
			backups_get)
				input=$(cat)
				nm=$(echo "$input" | jsonfilter -e '@.name' 2>/dev/null)
				if p=$(backup_check "$nm") && [ -r "$p" ]; then
					# keep the file byte-exact (incl. its trailing newline)
					# so View and Download match the backup on disk
					cfg_txt=$(cat "$p" 2>/dev/null; echo x)
					cfg_txt="${cfg_txt%x}"
					json_init
					json_add_boolean ok 1
					json_add_string name "$nm"
					json_add_string config "$cfg_txt"
					json_dump
				else
					json_init
					json_add_boolean ok 0
					json_add_string msg "no such backup"
					json_dump
				fi
			;;
			backups_delete)
				input=$(cat)
				nm=$(echo "$input" | jsonfilter -e '@.name' 2>/dev/null)
				if backup_check "$nm" >/dev/null; then
					msg=$("$SUB" backups-delete "$nm" 2>&1); rc=$?
					json_init
					json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"
					json_add_string msg "$msg"
					json_dump
				else
					json_init; json_add_boolean ok 0; json_add_string msg "no such backup"; json_dump
				fi
			;;
			backups_pin)
				input=$(cat)
				nm=$(echo "$input" | jsonfilter -e '@.name' 2>/dev/null)
				pin=$(echo "$input" | jsonfilter -e '@.pinned' 2>/dev/null)
				case "$pin" in 0|1) ;; *) pin="" ;; esac
				if backup_check "$nm" >/dev/null && [ -n "$pin" ]; then
					msg=$("$SUB" backups-pin "$nm" "$pin" 2>&1); rc=$?
					json_init
					json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"
					json_add_string msg "$msg"   # msg = the new (renamed) basename on success
					json_dump
				else
					json_init; json_add_boolean ok 0; json_add_string msg "no such backup"; json_dump
				fi
			;;
			backups_restore)
				input=$(cat)
				nm=$(echo "$input" | jsonfilter -e '@.name' 2>/dev/null)
				if backup_check "$nm" >/dev/null; then
					msg=$("$SUB" backups-restore "$nm" 2>&1); rc=$?
					json_init
					json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"
					json_add_string msg "$msg"
					json_dump
				else
					json_init; json_add_boolean ok 0; json_add_string msg "no such backup"; json_dump
				fi
			;;
			# Semantic diff of the current config vs a backup, as
			# paths_diff(current, backup): added = restore would add it,
			# removed = restore would drop it, changed = differs either way.
			config_diff)
				input=$(cat)
				nm=$(echo "$input" | jsonfilter -e '@.name' 2>/dev/null)
				if p=$(backup_check "$nm"); then
					"$SHARE/jsondiff-cli.uc" "$(config_file)" "$p" 2>/dev/null \
						|| { printf '{"added":[],"removed":[],"changed":[],"error":"diff failed"}'; }
				else
					printf '{"added":[],"removed":[],"changed":[],"error":"no such backup"}'
				fi
			;;
			*)         printf '{}' ;;
		esac
	;;
esac
