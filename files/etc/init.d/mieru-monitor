#!/bin/sh /etc/rc.common
# mieru client instances for luci-app-xray-monitor. One enabled UCI `mieru`
# section = one `mieru run` process (upstream's client serves a single
# activeProfile + socks5 port per process), plus one redsocks listener when
# the section sets a transparent port (mieru speaks SOCKS5 only, so redirected
# TCP needs the redsocks shim in front - see README for the ruantiblock
# wiring options). UCI is the single source of truth: runtime configs are
# regenerated into /var/etc (tmpfs) on every start/generate, so nothing under
# /etc is derived state. The app never touches firewall rules - what traffic
# reaches the transparent port is decided by whatever redirects it
# (ruantiblock, hand-written nftables/iptables, ...).
#
# extra command:  generate  - (re)write the runtime configs without starting
USE_PROCD=1
START=99
STOP=01
extra_commands="generate"

SHARE=/usr/share/xray-monitor
RUN=/var/etc/xray-monitor/mieru
MIERU=/usr/bin/mieru
REDSOCKS=/usr/bin/redsocks

mieru_ids() { uci show xray-monitor 2>/dev/null | sed -n 's/^xray-monitor\.\([^.]*\)=mieru$/\1/p'; }

# (Re)build /var/etc/xray-monitor/mieru: <id>.json for every enabled+valid
# section, redsocks-<id>.conf where a transparent port is set; files of
# removed/disabled/invalid sections are dropped, so the directory always
# mirrors UCI exactly. Invalid sections are logged and skipped - one bad
# hand-edit must not take the whole service down.
generate() {
	local id conn tmpd keep tp sp
	mkdir -p "$RUN"
	tmpd=$(mktemp -d "${TMPDIR:-/tmp}/mierugen.XXXXXX") || return 1
	keep=" "
	for id in $(mieru_ids); do
		[ "$(uci -q get "xray-monitor.$id.enabled")" = "0" ] && continue
		conn="$tmpd/$id.conn"
		if ! "$SHARE/mieru-uci.uc" "$id" > "$conn" 2>/dev/null \
			|| ! "$SHARE/mieru.uc" config "$conn" > "$RUN/$id.json.new" 2>/dev/null; then
			logger -t mieru-monitor "section $id is invalid - skipped"
			rm -f "$RUN/$id.json.new"
			continue
		fi
		mv "$RUN/$id.json.new" "$RUN/$id.json"
		keep="$keep$id "
		# transparent listener: redsocks answers redirected TCP on tproxy_port
		# and forwards into mieru's loopback socks5 port
		tp=$(uci -q get "xray-monitor.$id.tproxy_port")
		sp=$(uci -q get "xray-monitor.$id.socks5_port")
		if [ -n "$tp" ] && [ "$tp" != "0" ]; then
			cat > "$RUN/redsocks-$id.conf" <<EOF
base {
	log_debug = off;
	log_info = off;
	log = "syslog:daemon";
	daemon = off;
	redirector = iptables;
}
redsocks {
	local_ip = 0.0.0.0;
	local_port = $tp;
	ip = 127.0.0.1;
	port = $sp;
	type = socks5;
}
EOF
		else
			rm -f "$RUN/redsocks-$id.conf"
		fi
	done
	rm -rf "$tmpd"
	# drop runtime files of sections that no longer run
	for f in "$RUN"/*.json "$RUN"/redsocks-*.conf; do
		[ -f "$f" ] || continue
		id=$(basename "$f"); id=${id%.json}; id=${id%.conf}; id=${id#redsocks-}
		case "$keep" in *" $id "*) ;; *) rm -f "$f" ;; esac
	done
	return 0
}

start_service() {
	local id tp
	generate || return 1
	for id in $(mieru_ids); do
		[ -f "$RUN/$id.json" ] || continue   # disabled or invalid (generate logged it)
		if [ ! -x "$MIERU" ]; then
			logger -t mieru-monitor "mieru binary not found at $MIERU - install it from the Mieru tab"
			return 0
		fi
		procd_open_instance "mieru-$id"
		procd_set_param env MIERU_CONFIG_JSON_FILE="$RUN/$id.json"
		procd_set_param command "$MIERU" run
		procd_set_param respawn 3600 5 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
		if [ -f "$RUN/redsocks-$id.conf" ]; then
			if [ -x "$REDSOCKS" ]; then
				procd_open_instance "redsocks-$id"
				procd_set_param command "$REDSOCKS" -c "$RUN/redsocks-$id.conf"
				procd_set_param respawn 3600 5 0
				procd_close_instance
			else
				# soft dependency: the section works, only the transparent
				# listener cannot - say how to fix it instead of failing
				logger -t mieru-monitor "tproxy_port set for $id but redsocks is not installed (opkg install redsocks / apk add redsocks)"
			fi
		fi
	done
	return 0
}
