# Global settings. Subscriptions are separate 'subscription' sections
# (added from the UI), each with: prefix, url, enabled.
config xray-monitor 'sub'
	option user_agent 'v2rayNG/1.8.0'
	# scheduled fetch: enable + cron expression
	option cron '1'
	option cron_schedule '0 * * * *'
	# auto-apply (splice + restart xray) when a scheduled/manual fetch finds changes
	option auto_apply '0'
	# how many config.json.bak.* backups to keep (newest first; 0 = keep all;
	# pinned backups never count and are never pruned)
	option backup_keep '5'
	# auto-enable the Xray Stats API in config.json on package install (1=yes)
	option auto_enable_api '1'
	# end-to-end exit check: scheduled runs are OFF by default (each run pulls
	# a real body through every exit); e2e_schedule is its own cron expression
	option e2e_cron '0'
	option e2e_schedule '30 4 * * *'
	# small always-fast URL for TTFB, and the body URL for the throughput /
	# freeze check (%d is replaced with e2e_bytes, which makes the expected
	# size exact; a fixed-size URL is judged by "transfer finished" instead)
	option e2e_url_204 'https://cp.cloudflare.com/generate_204'
	option e2e_url_bytes 'https://speed.cloudflare.com/__down?bytes=%d'
	option e2e_bytes '1048576'
