# Global settings. Subscriptions are separate 'subscription' sections
# (added from the UI), each with: prefix, url, enabled.
config xray-monitor 'sub'
	option user_agent 'v2rayNG/1.8.0'
	# scheduled fetch: enable + cron expression
	option cron '1'
	option cron_schedule '0 * * * *'
	# auto-apply (splice + restart xray) when a scheduled/manual fetch finds changes
	option auto_apply '0'
	# how many config.json.bak.* backups to keep (newest first; 0 = keep all;
	# pinned backups never count and are never pruned)
	option backup_keep '5'
	# apply subscription outbound changes live via the xray API (rmo/ado) when
	# they are hot-swappable - no xray restart; anything else still restarts
	# (0 = always restart, the pre-F14 behavior)
	option hot_swap '1'
	# how subscription fetches reach the panel when the router itself cannot:
	# direct (default) | proxy (always through a temporary xray socks instance)
	# | auto (try direct, retry through xray on failure)
	option fetch_via 'direct'
	# same choice for self-update downloads only (0/direct = default; opkg
	# install itself always stays local)
	option fetch_via_update '0'
	# which exit the proxy path uses: an outbound tag, or 'auto' = best ok exit
	# from /tmp/xray-monitor/e2e.json, else the first outbound probing up
	option fetch_via_exit 'auto'
	# auto-enable the Xray Stats API in config.json on package install (1=yes)
	option auto_enable_api '1'
	# end-to-end exit check: scheduled runs are OFF by default (each run pulls
	# a real body through every exit); e2e_schedule is its own cron expression
	option e2e_cron '0'
	option e2e_schedule '30 4 * * *'
	# small always-fast URL for TTFB, and the body URL for the throughput /
	# freeze check (%d is replaced with e2e_bytes, which makes the expected
	# size exact; a fixed-size URL is judged by "transfer finished" instead)
	option e2e_url_204 'https://cp.cloudflare.com/generate_204'
	option e2e_url_bytes 'https://speed.cloudflare.com/__down?bytes=%d'
	option e2e_bytes '1048576'

# Sticky balancer overrides, managed from the Balancers tab (no defaults
# shipped - sections appear when the user pins a balancer). One section per
# balancer, applied live via the RoutingService (bo) and re-applied after
# every restart:
#   config balancer_override
#       option balancer '<balancer tag>'
#       option outbound '<outbound tag>'

# mieru proxy clients, managed from the Mieru tab (no defaults shipped - one
# section per connection; each runs its own `mieru run` instance via
# /etc/init.d/mieru-monitor, which regenerates /var/etc/xray-monitor/mieru/
# from these options on every start):
#   config mieru
#       option label 'work'            # display name (unique, A-Z a-z 0-9 . _ -)
#       option server_ip '12.34.56.78' # mieru server IP (or server_domain)
#       option server_domain ''        # optional domain name
#       list   server_ports '2012-2022/tcp'   # <port>[-<port>]/tcp|udp
#       option username '...'
#       option password '...'
#       option mtu '1400'              # 1280-1400, must match the server
#       option multiplexing 'MULTIPLEXING_LOW'
#       option handshake 'HANDSHAKE_STANDARD'
#       option socks5_port '1080'      # local SOCKS5 listen port (user-chosen)
#       option lan '0'                 # 1 = accept SOCKS5 from the LAN too
#                                      # (default 0: loopback only - redsocks
#                                      # and ruantiblock talk to 127.0.0.1)
#       option tproxy_port ''          # transparent port: a redsocks listener
#                                      # that feeds redirected TCP into mieru
#                                      # (empty/0 = no transparent listener)
#       option rpc_port '10090'        # per-instance management port (assigned
#                                      # automatically, 10090-10199)
#       option logging 'ERROR'
#       option enabled '1'
