{
	"dns": { "servers": [ "1.1.1.1", "9.9.9.9" ] },
	"log": { "access": "/tmp/xray-a.log", "loglevel": "info" },
	"outbounds": [
		{
			"tag": "proxy-de",
			"protocol": "vless",
			"settings": {
				"vnext": [
					{
						"address": "de.example.com",
						"port": 8443,
						"users": [ { "id": "11111111-2222-3333-4444-555555555555", "encryption": "none", "email": "u1@example.com" } ]
					}
				]
			},
			"streamSettings": {
				"network": "tcp",
				"security": "reality",
				"realitySettings": { "serverName": "de.example.com", "shortId": "ffff" }
			}
		},
		{ "tag": "direct", "protocol": "freedom" },
		{
			"tag": "proxy-nl",
			"protocol": "vless",
			"settings": {
				"vnext": [
					{
						"address": "nl.example.com",
						"port": 443,
						"users": [ { "id": "99999999-8888-7777-6666-555555555555", "encryption": "none" } ]
					}
				]
			},
			"streamSettings": { "network": "tcp", "security": "none" }
		}
	],
	"routing": {
		"rules": [ { "type": "field", "inboundTag": [ "api" ], "outboundTag": "api2" } ]
	}
}
