{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "tproxy-in",
      "protocol": "dokodemo-door",
      "listen": "0.0.0.0",
      "port": 12345,
      "settings": {
        "network": "tcp,udp",
        "followRedirect": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      }
    }
  ],
  "outbounds": [
    // === subscription: proxy ===,
    {
      "tag": "proxy-de",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "de1.example.org",
            "port": 443,
            "users": [
              {
                "id": "a342d11e-d424-4583-b36e-524ab1f0afa4",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "security": "reality",
        "network": "tcp",
        "realitySettings": {
          "serverName": "de.example.org",
          "publicKey": "pbVjhWqqvXcvKZW2jH3mBa9BHuK5iOLXeiCBBB9XKA0",
          "fingerprint": "chrome",
          "shortId": "0123",
          "spiderX": "/randomized"
        }
      }
    },
    // === subscription: proxy-work ===,
    {
      "tag": "proxy-work-fi",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "port": 8443,
            "address": "fiwork1.example.org",
            "users": [
              {
                "id": "b45be11f-d424-4583-b36e-524ab1f0afa4",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "spiderX": "/randomized-too",
          "serverName": "fiwork.example.org",
          "fingerprint": "chrome",
          "publicKey": "pbVjhWqqvXcvKZW2jH3mBa9BHuK5iOLXeiCBBB9XKA0",
          "shortId": "abcd"
        }
      }
    },
    // === local ===,
    {
      "tag": "manual-vps",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "5.6.7.8",
            "port": 2053,
            "users": [
              {
                "id": "f56cf220-d424-4583-b36e-524ab1f0afa4",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "manual.example.org",
          "fingerprint": "chrome",
          "publicKey": "pbVjhWqqvXcvKZW2jH3mBa9BHuK5iOLXeiCBBB9XKA0",
          "shortId": "",
          "spiderX": "/"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIP"
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "http"
        }
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "tproxy-in"
        ],
        "outboundTag": "proxy-de"
      }
    ]
  }
}