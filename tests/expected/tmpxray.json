  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "in-proxy-fi"
        ],
        "outboundTag": "proxy-fi"
      },
      {
        "type": "field",
        "inboundTag": [
          "in-proxy-ch"
        ],
        "outboundTag": "proxy-ch"
      }
    ]
