                "id": "d342d11e-d424-4583-b36e-524ab1f0afa4",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "fi.example.org",
          "fingerprint": "chrome",
          "publicKey": "pbVjhWqqvXcvKZW2jH3mBa9BHuK5iOLXeiCBBB9XKA0",
          "shortId": "0123",
          "spiderX": "/"
