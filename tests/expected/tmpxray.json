{
  "log": {
    "loglevel": "none"
  },
  "inbounds": [
    {
      "tag": "in-proxy-fi",
      "protocol": "socks",
      "listen": "127.0.0.1",
      "port": 10801,
      "settings": {
        "auth": "noauth",
        "udp": true
      }
    },
    {
      "tag": "in-proxy-ch",
      "protocol": "socks",
      "listen": "127.0.0.1",
      "port": 10802,
      "settings": {
        "auth": "noauth",
        "udp": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy-fi",
