      }
    },
    {
      "tag": "proxy-ch",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "ch1.example.org",
            "port": 8443,
            "users": [
              {
                "id": "e45be11f-d424-4583-b36e-524ab1f0afa4",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "ch.example.org",
          "fingerprint": "chrome",
          "publicKey": "pbVjhWqqvXcvKZW2jH3mBa9BHuK5iOLXeiCBBB9XKA0",
          "shortId": "abcd",
          "spiderX": "/api"
        }
      }
